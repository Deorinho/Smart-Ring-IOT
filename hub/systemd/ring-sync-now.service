# RavenX BLE sync, on demand — the unit behind the dashboard's Sync button.
#
# Identical to ring-sync.service except for --force, and deliberately a SEPARATE unit
# rather than a flag on the existing one:
#
#   * The scheduled unit must keep its minimum-interval guard, which protects the ring's
#     battery from a misbehaving trigger. Weakening it for the button weakens it for the
#     timer too.
#   * A manual sync means "I am standing next to the hub, right now". Skipping because a
#     scheduled run happened twenty minutes ago would make the button look broken.
#
# There is NO [Install] section on purpose. This unit is never enabled and never
# scheduled; it only runs because a human pressed something. Rate limiting lives in
# hub/api.py, which refuses to trigger it more than once a minute.
#
# hub/api.py starts this through `sudo -n systemctl start`, permitted by the single
# scoped rule in hub/systemd/ravenx-sudoers. That rule names this unit and nothing else.

[Unit]
Description=RavenX Smart Ring BLE sync (manual, forced)
After=bluetooth.target network.target
Wants=bluetooth.target

[Service]
Type=oneshot
User=warlock
Group=warlock
WorkingDirectory=/srv/ravenx/repo
ExecStart=/srv/ravenx/repo/.venv/bin/python -m hub.sync --force
Environment=PYTHONUNBUFFERED=1

TimeoutStartSec=300

PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/ravenx/data
