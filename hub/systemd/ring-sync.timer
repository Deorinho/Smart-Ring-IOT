# Three syncs a day, matching config.SYNC_HOURS_LOCAL.
#
# Three, not twenty. Sync frequency barely affects the ring's battery — the bytes moved
# per day are roughly constant regardless of how they are split — but the dashboard is
# something to glance at occasionally, not a live monitor. The earlier plan called for
# hourly syncs tightened to every 15 minutes; that was tuned for freshness, which is not
# what this project optimises for.
#
# OnCalendar is local time, deliberately: these hours are about when Abhi is likely near
# the hub, which is a human schedule. Everything stored is still UTC.
#
# Persistent=true catches up a missed run after the hub has been off. Combined with
# RandomizedDelaySec that means a boot at 09:00 fires a sync shortly after, once the
# Bluetooth stack has had time to come up.

[Unit]
Description=RavenX Smart Ring sync schedule

[Timer]
OnCalendar=*-*-* 08:00:00
OnCalendar=*-*-* 14:00:00
OnCalendar=*-*-* 22:00:00
Persistent=true
RandomizedDelaySec=120
Unit=ring-sync.service

[Install]
WantedBy=timers.target
