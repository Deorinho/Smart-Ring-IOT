# Three syncs a day. Freshness is not a priority here — CLAUDE.md's battery contract
# picks this cadence for "glance at it occasionally", not for a live dashboard.
#
# Persistent=true backfills a run missed while the machine was off. Note what that does
# NOT cover: a run missed because the service failed. That distinction mattered during
# R-018, when Persistent=true was set and every 08:00 and 14:00 slot still failed
# silently, because the timer fired correctly and the service could not execute.

[Unit]
Description=RavenX Smart Ring sync schedule

[Timer]
OnCalendar=*-*-* 08:00:00
OnCalendar=*-*-* 14:00:00
OnCalendar=*-*-* 22:00:00
Persistent=true
# A few minutes of jitter so three timers do not all wake the radio at once, and so a
# sync never lands at exactly the same second as the backup.
RandomizedDelaySec=180

[Install]
WantedBy=timers.target
