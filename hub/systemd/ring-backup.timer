# Nightly at 04:00. Chosen to sit well away from every sync slot (08:00/14:00/22:00) so
# a backup is never taken mid-write — though SQLite's backup API makes that safe anyway,
# which is the entire reason tools/backup.py does not use cp.

[Unit]
Description=RavenX Smart Ring nightly backup schedule

[Timer]
OnCalendar=*-*-* 04:00:00
Persistent=true
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
