# RavenX BLE sync — one attempt, then exit. Scheduled by ring-sync.timer.
#
# SYSTEM unit (Bug_Backlog R-018). As a user unit this never ran at boot and died with
# status=203/EXEC on every scheduled run while nobody was logged in, because
# .venv/bin/python sat inside an encrypted home that was not mounted.
#
# Type=oneshot because this is a script, not a daemon. Nothing holds a BLE connection
# between runs, so there is no state to leak and each sync is a discrete journal entry.
#
# After=bluetooth.target FINALLY MEANS SOMETHING (Bug_Backlog R-005). The Bluetooth
# stack comes up ~43 s into boot on this machine, and a Persistent timer firing at boot
# would otherwise meet no adapter. As a *user* unit this line was inert — a user manager
# cannot order against a system target — so the mitigation written in session 1 was
# never actually applied. It is applied now.
#
# An unreachable ring exits 0 on purpose. It is on a hand that leaves the house, so
# "not found" is a normal outcome several times a day; a unit that reports failure every
# time you go to work is a unit you learn to ignore.

[Unit]
Description=RavenX Smart Ring BLE sync
After=bluetooth.target network.target
Wants=bluetooth.target

[Service]
Type=oneshot
User=warlock
Group=warlock
WorkingDirectory=/srv/ravenx/repo
ExecStart=/srv/ravenx/repo/.venv/bin/python -m hub.sync
Environment=PYTHONUNBUFFERED=1

# The service has its own overall timeout; this is the outer backstop.
TimeoutStartSec=300

PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/ravenx/data

[Install]
WantedBy=multi-user.target
