# RavenX nightly backup — SQLite backup API, verified, rotated. Bug_Backlog R-004.
#
# SYSTEM unit (R-018). This one is the reason the P1 mattered: as a user unit it had
# never once fired, because 04:00 arrives when nobody is logged in and the encrypted
# home is unmounted. A backup regime that cannot run unattended is not a backup regime.

[Unit]
Description=RavenX Smart Ring backup
After=local-fs.target

[Service]
Type=oneshot
User=warlock
Group=warlock
WorkingDirectory=/srv/ravenx/repo
ExecStart=/srv/ravenx/repo/.venv/bin/python -m tools.backup
Environment=PYTHONUNBUFFERED=1

PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/ravenx/data

[Install]
WantedBy=multi-user.target
